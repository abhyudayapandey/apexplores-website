---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { PRODUCTION_ORIGIN } from "../../lib/seo";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: post.data.heroImage,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  author: {
    "@type": "Person",
    name: "Abhyudaya Pandey",
  },
  mainEntityOfPage: `${PRODUCTION_ORIGIN}/blog/${post.data.slug}`,
};
---

<Layout
  title={`${post.data.title} | AP Explores`}
  description={post.data.description}
  ogImage={post.data.heroImage}
  ogType="article"
  structuredData={blogPostingSchema}
>
  <article class="mx-auto max-w-2xl">
    <a
      href={withBase("/blog", import.meta.env.BASE_URL)}
      class="text-sm font-medium text-slate-500 hover:text-slate-900"
    >
      &larr; Back to Blog
    </a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      {post.data.title}
    </h1>
    <p class="mt-3 text-sm text-slate-500">
      {dateFormatter.format(post.data.date)}
      {post.data.updated && <> &middot; Updated {dateFormatter.format(post.data.updated)} </>}
      &middot; {post.data.readTime}
    </p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {post.data.categories.map((category) => (
        <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
          {category}
        </li>
      ))}
    </ul>
    <img
      src={post.data.heroImage}
      alt={post.data.title}
      class="mt-8 aspect-video w-full rounded-lg object-cover"
    />
    <div class="post-content mt-8 text-slate-700">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post-content :global(p) {
    margin-top: 1.25em;
  }
  .post-content :global(h2) {
    margin-top: 2em;
    font-size: 1.375rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }
  .post-content :global(strong) {
    font-weight: 600;
    color: rgb(15 23 42);
  }
  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content :global(ul) {
    margin-top: 1em;
    list-style: disc;
    padding-left: 1.5em;
  }
</style>

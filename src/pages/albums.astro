---
import Layout from "../layouts/Layout.astro";

const title = "Albums | AP Explores";
const description =
  "The 'Albums' page has my photos categorized based on the overall experience that I have had at various places i.e., the place, people, food and animals.";
---

<Layout title={title} description={description}>
  <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Albums</h1>
    <p class="mt-4 max-w-md text-slate-600">
      Photo albums are coming soon. Check back for a gallery of the places, people, food and
      animals I've encountered along the way.
    </p>
  </div>
</Layout>

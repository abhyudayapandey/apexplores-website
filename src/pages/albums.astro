---

<Layout title={title} description={description}>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Albums</h1>
  <p class="mt-2 max-w-2xl text-slate-600">{description}</p>

  <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
    {photos.map((photo, index) => (
      <li>
        <a href={photo} target="_blank" rel="noopener noreferrer" class="block">
          <img
            src={photo}
            alt={`Travel photo ${index + 1}`}
            loading="lazy"
            class="aspect-square w-full rounded-lg object-cover transition-opacity hover:opacity-90"
          />
        </a>
      </li>
    ))}
  </ul>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import WorldMap from "../components/WorldMap.astro";
import IndiaMap from "../components/IndiaMap.astro";

const title = "Travel Photographer & Consultant | AP Explores";
const description =
  "I am Abhyudaya Pandey. apexplores my personal website. I am an explorer. See the world through my perspective - the places I have been to, the people I met, the food I enjoyed and the animals I loved. Contact for travel consultations. Travel stories in the blog. Photos in my portfolio.";
const ogImage = "https://static.wixstatic.com/media/d10773_f1f0cb91d7654a31beb7960eff33b9a4~mv2.jpg";
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description} ogImage={ogImage}>
  <div class="full-bleed">
    <img
      src={ogImage}
      alt="A photograph from one of Abhyudaya's travels"
      class="h-[45vh] w-full object-cover sm:h-[60vh]"
    />
  </div>

  <section class="mx-auto mt-16 max-w-2xl text-center">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Welcome to AP Explores!
    </h1>
    <h2 class="mt-4 text-lg font-semibold text-slate-700">Hi, I am Abhyudaya Pandey.</h2>
    <p class="mt-6 text-slate-600">
      Engineer by profession, wanderer by instinct. I'd rather be the traveler who gets lost in a
      conversation with a local than the tourist ticking off landmarks. Off-season over peak
      season, back lanes over headline attractions — I'm here for the culture, the history, and
      the everyday rhythm of a place, not just the postcard shot.
    </p>
    <p class="mt-4 text-slate-600">
      This site is where those trips live: the photographs, and the stories that didn't fit in a
      caption.
    </p>
    <p class="mt-4 text-slate-600">
      For any queries or suggestions, feel free to contact me through the form below or follow me
      on my Instagram:
      <a
        href="https://instagram.com/apexplores"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-[var(--color-rust)] underline underline-offset-2"
      >
        @apexplores
      </a>
    </p>
  </section>

  <section class="mt-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Where I've Been
      </h2>
      <p class="mt-4 text-slate-600">
        From the Himalayas to the high streets of Europe, here's a running map of the corners of
        the world I've had the chance to explore. Click a highlighted country to read the story —
        or check back later, since more get added as I write them up.
      </p>
    </div>
  </section>

  <div class="full-bleed mt-10">
    <WorldMap variant="banner" />
  </div>

  <section class="mt-24">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Exploring India, State by State
        </h2>
        <p class="mt-4 text-slate-600">
          As an Indian, exploring every state and union territory of my own country matters just
          as much to me as chasing passport stamps abroad. Here's how far I've gotten so far.
        </p>
        <a
          href={`${base}/destinations/india`}
          class="mt-4 inline-block font-medium text-[var(--color-rust)] underline underline-offset-2 hover:text-[var(--color-rust-hover)]"
        >
          View the full state map &rarr;
        </a>
      </div>
      <div class="lg:justify-self-end lg:w-full">
        <IndiaMap />
      </div>
    </div>
    <p class="mt-4 text-right text-xs text-slate-400">
      Map data by
      <a
        href="https://github.com/VictorCazanave/svg-maps"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-slate-600"
      >
        svg-maps
      </a>
      (CC BY 4.0)
    </p>
  </section>

  <section id="contact" class="mx-auto mt-24 max-w-lg scroll-mt-20">
    <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900">CONTACT</h2>
    <form
      id="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
      class="mt-8 space-y-4"
      data-confirm="Thanks for submitting!"
    >
      <input type="hidden" name="form-name" value="contact" />
      <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-slate-700">Message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        ></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-md bg-[var(--color-rust)] px-4 py-2 font-medium text-white transition-colors hover:bg-[var(--color-rust-hover)]"
      >
        Submit
      </button>
      <p data-status class="text-center text-sm font-medium text-slate-700"></p>
    </form>
    <p class="mt-6 text-center text-sm text-slate-500">
      Or email me directly at
      <a href="mailto:pabhyudaya@gmail.com" class="font-medium text-slate-900 underline underline-offset-2">
        pabhyudaya@gmail.com
      </a>
    </p>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-status]");
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        params.append(key, value.toString());
      }
      try {
        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: params.toString(),
        });
        if (status) status.textContent = form.dataset.confirm ?? "";
        form.reset();
      } catch {
        if (status) {
          status.textContent = "Something went wrong. Please email me directly instead.";
        }
      }
    });
  </script>
</Layout>

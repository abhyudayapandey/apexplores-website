---
import Layout from "../../layouts/Layout.astro";
import { destinationPlaces } from "../../data/travel-map";

export async function getStaticPaths() {
  return destinationPlaces.map((place) => ({
    params: { slug: place.slug },
    props: { place },
  }));
}

const { place } = Astro.props;

const title = `${place.name} | AP Explores`;
const description = `Stories from ${place.name} — coming soon.`;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <div class="mx-auto max-w-lg text-center">
    <a href={`${base}/`} class="text-sm font-medium text-slate-500 hover:text-slate-900"
      >&larr; Back to Home</a
    >
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Stories from {place.name} — coming soon
    </h1>

    <div class="mt-12">
      <p class="text-slate-600">
        Want to know when the {place.name} story goes up? Leave your email and I'll let you know.
      </p>
      <form
        id="destination-notify-form"
        name="destination-notify"
        method="POST"
        data-netlify="true"
        class="mt-6 flex flex-col gap-3 sm:flex-row"
        data-confirm="Thanks for submitting!"
      >
        <input type="hidden" name="form-name" value="destination-notify" />
        <input type="hidden" name="place" value={place.slug} />
        <label for="email" class="sr-only">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
        <button
          type="submit"
          class="rounded-md bg-slate-900 px-4 py-2 font-medium text-white transition-colors hover:bg-slate-700"
        >
          Notify me
        </button>
      </form>
      <p data-status class="mt-3 text-sm font-medium text-slate-700"></p>
    </div>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>("#destination-notify-form");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = document.querySelector<HTMLElement>("[data-status]");
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        params.append(key, value.toString());
      }
      try {
        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: params.toString(),
        });
        if (status) status.textContent = form.dataset.confirm ?? "";
        form.reset();
      } catch {
        if (status) {
          status.textContent = "Something went wrong. Please try again later.";
        }
      }
    });
  </script>
</Layout>

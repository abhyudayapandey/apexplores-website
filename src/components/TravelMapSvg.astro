---
export interface MapRegion {
  key: string;
  name: string;
  /** A single path's `d` string. Use `paths` instead for a region assembled from multiple independent path strings. */
  path?: string;
  /**
   * Multiple independent path `d` strings, rendered as separate <path> elements.
   * Required when combining path data from more than one source, since each
   * <path> needs its own parsing context — merging separate strings into one
   * `d` attribute breaks the implicit-relative-lineto coordinates that follow
   * each string's leading moveto command.
   */
  paths?: string[];
  visited: boolean;
  href?: string;
  /** SVG transform applied to a wrapping <g>, for regions assembled from a different coordinate space. */
  transform?: string;
  /** Overrides the default stroke width, to compensate for a region-specific transform's scale. */
  strokeWidth?: number;
}

interface Props {
  viewBox: string;
  label: string;
  regions: MapRegion[];
  mapKey: string;
  variant?: "card" | "banner";
}

const { viewBox, label, regions, mapKey, variant = "card" } = Astro.props;
---

<div class="travel-map-card" data-map={mapKey} data-variant={variant}>
  <svg viewBox={viewBox} role="img" aria-label={label} class="travel-map">
    {
      regions.map((region) =>
        region.visited ? (
          <a href={region.href} class="region visited" data-name={region.name}>
            <g transform={region.transform}>
              <g class="hover-scale">
                {(region.paths ?? [region.path]).map((d) => (
                  <path
                    d={d}
                    style={region.strokeWidth ? `stroke-width:${region.strokeWidth}` : undefined}
                  />
                ))}
              </g>
            </g>
          </a>
        ) : (
          <path
            d={region.path}
            transform={region.transform}
            class="region unvisited"
            aria-label={region.name}
          />
        )
      )
    }
  </svg>
  <div class="map-tooltip" data-tooltip hidden></div>
</div>

<style>
  .travel-map-card {
    position: relative;
    background: var(--color-paper);
    border: 1px solid var(--color-paper-border);
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .travel-map-card[data-variant="banner"] {
    border-left: none;
    border-right: none;
    border-radius: 0;
    padding: 2rem 1.5rem;
  }

  .travel-map {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 1024px) {
    .travel-map-card[data-variant="banner"] {
      min-height: 50vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .travel-map-card[data-variant="banner"] .travel-map {
      max-width: 1600px;
      margin: 0 auto;
    }
  }

  .region.unvisited {
    fill: var(--color-map-neutral);
    stroke: var(--color-paper);
    stroke-width: 0.6;
  }

  a.region.visited path {
    fill: var(--color-rust);
    stroke: var(--color-paper);
    stroke-width: 0.6;
    transition: fill 0.15s ease;
  }

  /*
   * The hover-scale effect targets an inner <g class="hover-scale">, never
   * the outer positioning <g> (which carries an SVG `transform` attribute
   * for regions assembled from a different coordinate space, like India on
   * the world map). Putting any CSS `transform`-related property on that
   * outer <g> — even just `transition: transform` — makes the browser treat
   * CSS as authoritative for `transform` and silently drop the attribute's
   * translate/scale, even while at rest with no active hover.
   */
  .hover-scale {
    transition: transform 0.15s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  a.region.visited {
    cursor: pointer;
  }

  a.region.visited:hover path,
  a.region.visited:focus-visible path {
    fill: var(--color-rust-hover);
  }

  a.region.visited:hover .hover-scale,
  a.region.visited:focus-visible .hover-scale {
    transform: scale(1.08);
  }

  a.region.visited:focus-visible {
    outline: 2px solid var(--color-indigo);
    outline-offset: 2px;
  }

  .map-tooltip {
    position: fixed;
    z-index: 50;
    pointer-events: none;
    background: var(--color-indigo);
    color: var(--color-paper);
    font-family: var(--font-space-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    white-space: nowrap;
    transform: translate(-50%, -140%);
  }

  .map-tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".travel-map-card");
  cards.forEach((card) => {
    const tooltip = card.querySelector<HTMLElement>("[data-tooltip]");
    if (!tooltip) return;
    const regions = card.querySelectorAll<HTMLElement>(".region.visited");
    regions.forEach((region) => {
      const name = region.dataset.name ?? "";
      region.addEventListener("pointerenter", () => {
        tooltip.textContent = name;
        tooltip.hidden = false;
      });
      region.addEventListener("pointermove", (event) => {
        tooltip.style.left = `${event.clientX}px`;
        tooltip.style.top = `${event.clientY}px`;
      });
      region.addEventListener("pointerleave", () => {
        tooltip.hidden = true;
      });
    });
  });
</script>

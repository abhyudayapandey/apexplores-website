---
import worldMap from "@svg-maps/world";
import { visitedCountries } from "../data/travel-map";
import TravelMapSvg, { type MapRegion } from "./TravelMapSvg.astro";
import { withBase } from "../lib/url";

interface SvgMapLocation {
  id: string;
  name: string;
  path: string;
}

interface Props {
  variant?: "card" | "banner";
}

const { variant = "card" } = Astro.props;

const base = import.meta.env.BASE_URL;

/**
 * India renders from @svg-maps/world's own single country-level polygon,
 * exactly like every other country here — no per-state paths, so no internal
 * borders/seams. Note: this polygon's Jammu & Kashmir boundary is narrower
 * than the correct one used on the dedicated India state map (it's missing
 * the Aksai Chin bulge and the full northern extent) — confirmed by visually
 * comparing both datasets side by side. That's an inherent property of this
 * dataset's India polygon, not an artifact of any processing here, so fixing
 * it would mean sourcing a different world-level dataset with both a correct
 * J&K boundary and single-polygon (seamless) countries.
 */
const regions: MapRegion[] = worldMap.locations.map((loc: SvgMapLocation) => {
  const visited = visitedCountries[loc.id.toUpperCase()];
  return {
    key: loc.id,
    name: visited ? visited.name : loc.name,
    path: loc.path,
    visited: Boolean(visited),
    href: visited
      ? withBase(visited.href ?? `/destinations/${visited.slug}`, base)
      : undefined,
  };
});
---

<TravelMapSvg
  viewBox={worldMap.viewBox}
  label={worldMap.label}
  regions={regions}
  mapKey="world"
  variant={variant}
/>

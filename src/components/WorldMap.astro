---
import { worldMap } from "../data/world-map";
import { visitedCountries } from "../data/travel-map";
import TravelMapSvg, { type MapRegion } from "./TravelMapSvg.astro";
import { withBase } from "../lib/url";

interface Props {
  variant?: "card" | "banner";
}

const { variant = "card" } = Astro.props;

const base = import.meta.env.BASE_URL;

/**
 * worldMap (see src/data/world-map.ts) is generated from a single Natural
 * Earth dataset where every country's shared borders are digitized once and
 * reused by its neighbors — including India's, per India's own official
 * boundary claim. That's what makes this reliable where the previous
 * @svg-maps/world + merged-@svg-maps/india approach wasn't: there's no
 * second, independently-digitized shape to reconcile against the rest of
 * the map, so no border can gap or get clipped by a neighbor. India needs
 * no special-casing here at all — it renders exactly like every other
 * country.
 */
const regions: MapRegion[] = worldMap.locations.map((loc) => {
  const visited = visitedCountries[loc.id.toUpperCase()];
  return {
    key: loc.id,
    name: visited ? visited.name : loc.name,
    path: loc.path,
    visited: Boolean(visited),
    href: visited
      ? withBase(visited.href ?? `/destinations/${visited.slug}`, base)
      : undefined,
  };
});
---

<TravelMapSvg
  viewBox={worldMap.viewBox}
  label={worldMap.label}
  regions={regions}
  mapKey="world"
  variant={variant}
/>

---
import "../styles/global.css";
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  getCanonicalUrl,
  isProductionDeploy,
} from "../lib/seo";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  /** One or more JSON-LD objects, rendered as separate <script type="application/ld+json"> tags. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = DEFAULT_OG_IMAGE, ogType = "website", structuredData } =
  Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, base);
const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const navLinks = [
  { href: withBase("/", base), label: "Home" },
  { href: withBase("/blog", base), label: "Blog" },
  { href: withBase("/albums", base), label: "Albums" },
  { href: withBase("/#contact", base), label: "Contact" },
];

const socialLinks = [{ href: "https://instagram.com/apexplores", label: "Instagram" }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg", base)} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      !isProductionDeploy && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      structuredDataList.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a
          href={withBase("/", base)}
          class="font-[Fraunces] text-xl font-semibold tracking-tight text-slate-900"
        >
          AP Explores
        </a>
        <nav>
          <ul class="flex gap-6 text-sm font-medium text-slate-600">
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-[var(--color-rust)]">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-slate-200">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:justify-between">
        <p>&copy; {new Date().getFullYear()} by Abhyudaya Pandey.</p>
        <ul class="flex gap-5">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-[var(--color-rust)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>
